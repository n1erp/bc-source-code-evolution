function Start-InvoiceServer {
    $wkhtmltopdfExe = Get-ChildItem -Path "$env:ProgramFiles\wkhtmltopdf" -Recurse -Filter "wkhtmltopdf.exe" -ErrorAction SilentlyContinue
    Write-Host "Found wkhtmltopdf at $($wkhtmltopdfExe.FullName)"
    python (Join-Path $PSScriptRoot "Python\api.py") $wkhtmltopdfExe.FullName
}

Export-ModuleMember -Function Start-InvoiceServer
