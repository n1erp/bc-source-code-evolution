function Get-Company{
    param(
        [ValidateSet("NavUserPassword")] # Currently only NavUserPassword authentication supported.
        [string] $AuthorizationType,
        [pscredential] $Credential,
        [string] $ServiceUrl,
        [string] $Version = 'v1.0'
    )

    $Uri = "$ServiceUrl/api/Microsoft/PerformancToolkit/$Version/companies"    
    $Response = Invoke-RestMethod -Method GET -Uri $Uri -Credential $Credential
    
    return $Response.value
}

function Get-BCPTSuites{
    param(
        [ValidateSet("NavUserPassword")] # Currently only NavUserPassword authentication supported.
        [string] $AuthorizationType,
        [pscredential] $Credential,
        [string] $ServiceUrl,
        [string] $Version = 'v1.0',
        [string] $companyId
    )

    $Uri = "$ServiceUrl/api/Microsoft/PerformancToolkit/$Version/companies($companyId)/bcptSuites"
    $Response = Invoke-RestMethod -Method GET -Uri $Uri -Credential $Credential
    
    return $Response.value
}

function Get-BCPTSuitesLines{
    param(
        [ValidateSet("NavUserPassword")] # Currently only NavUserPassword authentication supported.
        [string] $AuthorizationType,
        [pscredential] $Credential,
        [string] $ServiceUrl,
        [string] $Version = 'v1.0',
        [string] $companyId
    )

    $Uri = "$ServiceUrl/api/Microsoft/PerformancToolkit/$Version/companies($companyId)/bcptSuiteLines"
    $Response = Invoke-RestMethod -Method GET -Uri $Uri -Credential $Credential
    
    return $Response.value
}

function Post-BCPTSuites{
    param(
        [ValidateSet("NavUserPassword")] # Currently only NavUserPassword authentication supported.
        [string] $AuthorizationType,
        [pscredential] $Credential,
        [string] $ServiceUrl,
        [string] $Version = 'v1.0',
        [string] $companyId,
        [string] $JsonBody
    )

        $Uri = "$ServiceUrl/api/Microsoft/PerformancToolkit/$Version/companies($companyId)/bcptSuites"
        $Response = Invoke-RestMethod -Method POST -Uri $Uri -Body $JsonBody -ContentType 'application/json' -Credential $Credential
        
        return $Response   
}

